# Required: Strong random string for JWT authentication tokens
JWT_SECRET=replace_with_a_secure_random_secret_key_2026

# Allowed CORS origins (comma-separated). Default is same-origin only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Initial Admin user creation on first run (if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_8chars

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
